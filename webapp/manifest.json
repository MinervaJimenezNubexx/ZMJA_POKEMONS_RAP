{
  "_version": "1.80.0",
  "sap.app": {
    "id": "com.nbx.pokerap",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.21.0",
      "toolsId": "f1a08e8c-a2cb-4e18-b6ff-e258e4bc0f2f"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zmja_ui_trainers_o4/srvd/sap/zmja_ui_trainers/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.142.7",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.nbx.pokerap.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.nbx.pokerap.view",
        "async": true,
        "viewPath": "com.nbx.pokerap.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteTeams",
          "pattern": "Trainer/{trainerId}/{isActive}",
          "target": [
            "TargetDetail"
          ]
        },
        {
          "name": "RouteCaptures",
          "pattern": "Captures/:contextPath:",
          "target": [
            "TargetCaptures"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetDetail": {
          "id": "Detail",
          "name": "Detail"
        },
        "TargetCaptures": {
          "id": "Captures",
          "name": "Captures"
        }
      }
    },
    "rootView": {
      "viewName": "com.nbx.pokerap.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}